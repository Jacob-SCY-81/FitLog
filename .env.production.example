# ==========================================
# FitLog 生产环境配置模板 (.env.production.example)
# 请复制为 .env 并填入真实的生产凭据
# ==========================================

# --- 基础配置 ---
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://fitlog.example.com

# --- 数据库配置 (MySQL 8.0) ---
# 格式: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=fitlog_prod
MYSQL_USER=fitlog_user
MYSQL_PASSWORD=your_secure_db_password_here
DATABASE_URL=mysql://fitlog_user:your_secure_db_password_here@mysql:3306/fitlog_prod

# --- 缓存与限流驱动 (Redis 7.0) ---
# 格式: redis://:<PASSWORD>@<HOST>:<PORT>/<DB>
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0
VERIFICATION_STORE=redis
RATE_LIMITER=redis

# --- JWT 认证密钥 (必须使用高强度随机字符，至少32位) ---
JWT_ACCESS_SECRET=replace_with_a_very_long_secure_random_string_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_very_long_secure_random_string_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- 生产短信服务 (SMS) ---
# 驱动类型: dev | mock | aliyun | tencent (Stage环境默认建议使用 mock)
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=your_aliyun_access_key_id
SMS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
SMS_SIGN_NAME=FitLog
SMS_TEMPLATE_CODE=SMS_123456789

# --- 生产邮件服务 (SMTP) ---
# 驱动类型: dev | mock | smtp
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fitlog.example.com
SMTP_PASS=your_smtp_auth_password
EMAIL_FROM=FitLog团队 <noreply@fitlog.example.com>
